{
  "$schema": "https://opencode.ai/config.json",

  "model": "lightning/anthropic/claude-opus-4-8",

  "plugin": [
    "./plugins/harness.ts",
    "./plugins/ultracode-runtime.ts",
    "./plugins/subagents.ts",
    "./plugins/skills.ts",
    "./plugins/advanced-features.ts",
    "./plugins/dynamic-workflows.ts",
    "./plugins/runtime.ts",
    "./plugins/shell-bridge.ts",
    "./plugins/rlm-bridge.ts",
    "./plugins/verifier.ts",
    "./plugins/evolver.ts",
    "./plugins/workflow-executor.ts",
    "./plugins/graphify-bridge.ts",
    "./plugins/memory-scanner.ts",
    "./plugins/profile-system.ts",
    "./plugins/simulation-engine.ts",
    "./plugins/interview-system.ts",
    "./plugins/report-system.ts",
    "./plugins/simulation-watch.ts",
    "./plugins/hooks.ts",
    "./plugins/tiered-context.ts"
  ],

  "provider": {
    "lightning": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lightning AI",
      "options": {
        "baseURL": "https://lightning.ai/api/v1",
        // "apiKey": "your-api-key-here",
        "timeout": 120000
      },
      "models": {
        "anthropic/claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 1000000, "output": 32000 },
          "cost": { "input": 5.00, "output": 25.00 },
          "variants": {
            "high": { "options": { "thinking": { "type": "enabled", "budgetTokens": 16000 } } },
            "max": { "options": { "thinking": { "type": "enabled", "budgetTokens": 32000 } } },
            "ultracode": { "options": { "thinking": { "type": "enabled", "budgetTokens": 32000 } } }
          }
        },
        "openai/gpt-5.5-2026-04-23": {
          "name": "GPT 5.5",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 1050000, "output": 32000 },
          "cost": { "input": 5.00, "output": 30.00 },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        },
        "anthropic/claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "limit": { "context": 1000000, "output": 32000 },
          "cost": { "input": 10.00, "output": 50.00 },
          "variants": {
            "high": { "options": { "thinking": { "type": "enabled", "budgetTokens": 16000 } } },
            "max": { "options": { "thinking": { "type": "enabled", "budgetTokens": 32000 } } }
          }
        },
        "lightning-ai/gpt-oss-20b": {
          "name": "GPT OSS 20B (Free)",
          "tool_call": true,
          "limit": { "context": 128000, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        },
        "lightning-ai/gpt-oss-120b": {
          "name": "GPT OSS 120B (Free)",
          "tool_call": true,
          "limit": { "context": 128000, "output": 131072 },
          "cost": { "input": 0, "output": 0 }
        },
        "lightning-ai/gemma-4-31B-it": {
          "name": "Gemma 4 31B (Free)",
          "tool_call": true,
          "limit": { "context": 131000, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  },

  "agent": {
    "build": {
      "steps": 50
    },
    "plan": {
      "steps": 30
    }
  },

  "instructions": [
    "C:/Users/Lenovo/.config/opencode/AGENTS.md"
  ],

  "snapshot": true,

  "compaction": {
    "auto": true,
    "tail_turns": 20
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git branch *": "allow",
      "git log *": "allow",
      "git diff *": "allow",
      "git checkout -b *": "allow",
      "git checkout test/*": "allow",
      "git push *": "deny",
      "git merge *": "deny",
      "git checkout main": "ask",
      "git checkout master": "ask",
      "npx *": "allow",
      "npx * | *": "allow",
      "npm *": "allow",
      "node *": "allow",
      "bun *": "allow",
      "python *": "allow",
      "cargo *": "allow",
      "* tsc *": "allow",
      "* tsc --noEmit *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "findstr *": "allow",
      "more *": "allow",
      "tail *": "allow",
      "true": "allow"
    }
  },

  "command": {
    "branch": {
      "description": "Create a new branch and switch to it",
      "template": "Create a new git branch called {{name}} and switch to it, then verify the current branch is {{name}} with git branch --show-current."
    },
    "push": {
      "description": "Push current branch to GitHub",
      "template": "First check the current branch with git branch --show-current. Then push only that branch to origin with git push -u origin $(git branch --show-current). Confirm the branch name before pushing."
    },
    "branches": {
      "description": "List all branches in the project",
      "template": "List all local and remote git branches, clearly marking which one is active."
    },
    "merge": {
      "description": "Merge a branch into the current branch",
      "template": "First show the current branch with git branch --show-current. Then merge {{name}} into the current branch. Only proceed if the user confirms."
    }
  }
}

